{erl_opts, [debug_info]}.
{deps, [
    {cowboy, "2.10.0"},
    {jsx, "3.1.0"},
    {epgsql, "4.7.0"}
]}.

{relx, [
    {release, {noalgo_backend, "0.1.0"}, [
        noalgo_backend,
        sasl,
        cowboy,
        jsx,
        epgsql
    ]},
    {sys_config, "./config/sys.config"},
    {vm_args, "./config/vm.args"},
    {dev_mode, true},
    {include_erts, false},
    {extended_start_script, true}
]}.
